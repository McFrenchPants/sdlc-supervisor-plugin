# Project policy for the sdlc-supervisor framework.
# Shape documented at docs/sdlc/schemas/project.schema.json.
# Generated by /continue-development's init step on {{INIT_DATE}}.
# Hand-edit this file freely as the project's needs change -- it is not
# regenerated automatically once it exists.
framework_version: "0.1.0"
schema_version: "1.0.0"

path_enforcement:
  # Kill switch for the PreToolUse path-enforcement hook. Flip with Bash
  # (sed/python), never with Edit/Write -- editing this file with Edit/Write
  # to turn enforcement off is exactly the self-lock this warning exists to
  # prevent. Absent file or absent key means enforcing.
  enforce: true

budgets:
  max_tasks_per_run: 5
  max_concurrent_implementers: 1
  max_attempts_per_task: 3
  max_verifier_retries: 2
  token_or_time_budget:
    tokens: null
    minutes: 120

verification_profile:
  # Fixed floor -- reproduced verbatim, do not edit. Widen coverage via
  # `widen` below instead of touching this list.
  floor_triggers:
    - authentication_authorization
    - data_persistence_migrations
    - deployment_release_tooling
    - production_mutation_tier_or_above
  # Project-specific additions to the floor. Fill this in with whatever
  # this project's own real risk areas are, e.g.:
  #   - third_party_credential_or_token_handling
  #   - payment_handling
  #   - shared_external_account_access
  widen: []

# Present only when release mode is "full". Delete this whole block for a
# "lite" project (no supervisor agent, no approval records -- work stops at
# "implemented, tested, committed to a feature branch").
release:
  mode: "{{RELEASE_MODE}}"
  integration_branch: "{{INTEGRATION_BRANCH}}"
  production_branch: "{{PRODUCTION_BRANCH}}"
  live_systems: []

# Paths the implementer role may never write to, regardless of any task
# packet's write_paths. Typically this project's own tracking docs.
always_forbidden_paths:
  - "{{BACKLOG_FILE}}"
  - "{{PROGRESS_FILE}}"

owned_files:
  - ".sdlc/**"
  - "docs/sdlc/**"
  - "agents/implementer.md"
  - "agents/verifier.md"
